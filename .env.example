# ==============================================================================
# HN-Link Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Generation (OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key

# ------------------------------------------------------------------------------
# 2. LinkedIn Publishing (UGC API v2)
# ------------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:your_id

# Optional: OAuth 2.0 Refresh Token (requires approved app with offline_access)
# LINKEDIN_CLIENT_ID=your_client_id
# LINKEDIN_CLIENT_SECRET=your_client_secret
# LINKEDIN_REFRESH_TOKEN=your_refresh_token

# Optional: Secure Credential Storage & Encryption at Rest (Fix M-2)
# File path for storing rotated credentials with 0600 permissions (defaults to .credentials_store.json)
# HN_LINK_CREDENTIALS_FILE=/path/to/.credentials_store.json
# Secret key used to encrypt credentials at rest via authenticated HMAC-SHA256
# HN_LINK_ENCRYPTION_KEY=generate_a_secure_random_key_here

# ------------------------------------------------------------------------------
# 3. Telegram Bot (Security-Hardened)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Authorization allowlist: Comma-separated user IDs and/or chat IDs permitted to use the bot
# Fails closed if empty. Obtain your numeric user ID from @userinfobot on Telegram.
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_ALLOWED_CHATS=123456789
# Legacy alias for backward compatibility:
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 4. Flask API Server & Webhooks (Security-Hardened)
# ------------------------------------------------------------------------------
# Required for /pipeline/* endpoints. Use constant-time header auth:
# Authorization: Bearer <token> or X-API-Key: <token>
HN_LINK_API_KEY=generate_a_secure_random_token_here
N8N_WEBHOOK_TOKEN=generate_a_secure_random_token_here

# Network binding: Defaults to localhost (127.0.0.1) and debug=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# ------------------------------------------------------------------------------
# 5. Database & Deduplication Storage
# ------------------------------------------------------------------------------
# Optional: Override default SQLite database path (defaults to post_history.db in project root)
# HN_LINK_DB_PATH=/path/to/custom_post_history.db

# ------------------------------------------------------------------------------
# 6. Pipeline Curation Settings
# ------------------------------------------------------------------------------
HN_TOP_STORIES_COUNT=15
HN_RANDOM_RISING_COUNT=5
HN_MIN_SCORE=50
CONTENT_MAX_CHARS=8000
POSTS_TO_GENERATE=3
